<?xml version="1.0" encoding="utf-8"?>
<!--
    These rules define what data is included in Android's Auto Backup and Device Transfer.
    See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up all supported content by default. -->
        <include domain="root" />
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="external" />

        <!--
        CRITICAL: Exclude the cache directory.
        The cache contains large, temporary files (like unzipped EPUBs)
        that should not be backed up. They can be regenerated when the
        user reopens a book.
        -->
        <exclude domain="file" path="cache" />
    </cloud-backup>

    <device-transfer>
        <!--
        For device-to-device transfers, we can include everything, including the cache,
        as this is a one-time, high-bandwidth operation that improves the user's
        experience by having their books ready immediately on their new phone.
        -->
        <include domain="root" />
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
        <include domain="external" />
    </device-transfer>
</data-extraction-rules>